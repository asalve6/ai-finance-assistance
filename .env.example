# Copy to .env (never commit .env)

# Which LLM provider the app talks to: anthropic | openai
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Model per tier, for the chosen provider. FAST is for routing and review, MAIN for answers.
# If you switch LLM_PROVIDER, set these to models your key can use.
LLM_MODEL_FAST=claude-haiku-5-5
LLM_MODEL_MAIN=claude-sonnet-5-5

# Market data. yfinance needs no key. Alpha Vantage is the fallback.
ALPHAVANTAGE_API_KEY=

DATABASE_URL=postgresql+psycopg://penny:penny@localhost:5432/penny
