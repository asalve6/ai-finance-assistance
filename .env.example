# Copy to .env (never commit .env)

# Which LLM provider the app talks to: anthropic | openai
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# The OpenAI key is also used for knowledge-base embeddings.
OPENAI_API_KEY=

# Optional. Leave blank to use the defaults for the chosen provider:
#   anthropic: claude-haiku-5-5 (fast), claude-sonnet-5-5 (main)
#   openai:    gpt-4o-mini (fast), gpt-4o (main)
# If you switch LLM_PROVIDER, clear these or set models that provider offers.
LLM_MODEL_FAST=
LLM_MODEL_MAIN=

# Knowledge-base search: openai (default) | hashing (offline tests) | minilm (optional local model)
KB_EMBEDDER=openai

# Market data. yfinance needs no key. Alpha Vantage is the fallback.
ALPHAVANTAGE_API_KEY=

DATABASE_URL=postgresql+psycopg://penny:penny@localhost:5432/penny
